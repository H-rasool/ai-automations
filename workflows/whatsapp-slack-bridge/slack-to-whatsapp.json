    {
      "parameters": {
        "jsCode": "// PRODUCTION MEDIA PARSER - STABLE BINARY CONVERSION\nconst items = $input.all();\nconst returnData = [];\n\nfor (let i = 0; i < items.length; i++) {\n  try {\n    // 1. Check if binary data exists\n    const binaryData = items[i].binary;\n    if (!binaryData || !binaryData.data) {\n      continue; // Skip if Get Media didn't provide a file\n    }\n\n    // 2. Read binary buffer\n    const binaryBuffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n    \n    // 3. Merge metadata with Base64\n    returnData.push({\n      json: {\n        ...items[i].json, // Keep remoteJid, mediaType, etc.\n        base64: binaryBuffer.toString('base64')\n      }\n    });\n  } catch (error) {\n    // Handle specific binary errors\n    continue;\n  }\n}\n\nreturn returnData;"
      },
