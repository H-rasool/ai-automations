# =============================================================================
# Copy to `.env` and fill in. NEVER commit the real .env (it is git-ignored).
# Generate strong secrets with:   openssl rand -hex 32
# =============================================================================

# --- Image tags --------------------------------------------------------------
POSTGRES_TAG=15-alpine
EVOLUTION_TAG=latest              # pin a specific Evolution API version for production

# --- Host ports (bound to 127.0.0.1 only) ------------------------------------
N8N_HOST_PORT=5678
EVOLUTION_HOST_PORT=8080
MIDDLEWARE_HOST_PORT=5001
PGADMIN_HOST_PORT=5050

# --- Public URL (webhooks) ---------------------------------------------------
# Slack and the WhatsApp gateway must be able to reach n8n. With the optional
# Cloudflare tunnel, paste the https URL printed by `docker compose logs tunnel`.
EXTERNAL_BASE_URL=http://localhost:5678

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=evolution
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=evolutiondb

# --- n8n ---------------------------------------------------------------------
# Encrypts every credential stored in n8n. Keep it safe: lose it and the stored
# credentials cannot be decrypted. Do not change it after first start.
N8N_ENCRYPTION_KEY=CHANGE_ME
GENERIC_TIMEZONE=UTC              # schedules (reminders, EOD summary) run in this timezone

# --- Evolution API (WhatsApp gateway) ----------------------------------------
EVOLUTION_API_KEY=CHANGE_ME

# --- Smartsheet middleware ---------------------------------------------------
# Shared secret n8n sends in the X-API-KEY header when it calls the middleware.
MIDDLEWARE_API_KEY=CHANGE_ME
SMARTSHEET_TOKEN=CHANGE_ME        # Smartsheet > Account > Personal Settings > API Access
SHEET_ID_PROJECT_A=               # numeric Smartsheet sheet ID for project A
SHEET_ID_PROJECT_B=               # numeric Smartsheet sheet ID for project B

# --- Admin assistant ---------------------------------------------------------
# WhatsApp number allowed to query the assistant, in JID form: <country code><number>@s.whatsapp.net
ADMIN_WHATSAPP_JID=15550000001@s.whatsapp.net

# --- pgAdmin (only with --profile tools) -------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
